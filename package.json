{
  "name": "@oneunit/realtime",
  "version": "2.0.0",
  "description": "Local realtime WebSocket infrastructure for Node.js: in-memory channels and fan-out, adaptive backpressure, shared heartbeat timer, connection and document rooms, auth/authorization hooks, transport adapter (uWebSockets.js), Libsodium end-to-end encryption, and CRDT collaboration. Single-process, zero-broker, transport-neutral core.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js",
      "default": "./dist/transport/index.js"
    },
    "./hub": {
      "types": "./dist/core/core-hub.d.ts",
      "import": "./dist/core/core-hub.js",
      "default": "./dist/core/core-hub.js"
    },
    "./e2ee": {
      "types": "./dist/e2ee/primitives.d.ts",
      "import": "./dist/e2ee/primitives.js",
      "default": "./dist/e2ee/primitives.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "default": "./dist/errors/index.js"
    },
    "./presence": {
      "types": "./dist/presence/index.d.ts",
      "import": "./dist/presence/index.js",
      "default": "./dist/presence/index.js"
    },
    "./room-namespace": {
      "types": "./dist/room-namespace/index.d.ts",
      "import": "./dist/room-namespace/index.js",
      "default": "./dist/room-namespace/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "default": "./dist/protocol/index.js"
    },
    "./event": {
      "types": "./dist/event/index.d.ts",
      "import": "./dist/event/index.js",
      "default": "./dist/event/index.js"
    },
    "./collab": {
      "types": "./dist/collab/index.d.ts",
      "import": "./dist/collab/index.js",
      "default": "./dist/collab/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./package.json": "./package.json",
    "./express": {
      "types": "./dist/host/host-server-adapter.d.ts",
      "import": "./dist/host/host-server-adapter.js",
      "default": "./dist/host/host-server-adapter.js"
    },
    "./fastify": {
      "types": "./dist/host/host-server-adapter.d.ts",
      "import": "./dist/host/host-server-adapter.js",
      "default": "./dist/host/host-server-adapter.js"
    },
    "./koa": {
      "types": "./dist/host/host-server-adapter.d.ts",
      "import": "./dist/host/host-server-adapter.js",
      "default": "./dist/host/host-server-adapter.js"
    },
    "./node-http": {
      "types": "./dist/host/host-server-adapter.d.ts",
      "import": "./dist/host/host-server-adapter.js",
      "default": "./dist/host/host-server-adapter.js"
    }
  },
  "files": [
    "dist",
    "src",
    "examples",
    "docs",
    "LICENSE",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');for(const p of ['dist','tsconfig.tsbuildinfo'])fs.rmSync(p,{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "npm run typecheck:src && npm run typecheck:test && npm run typecheck:examples",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run build && npm run typecheck && npm test && npm run pack:check"
  },
  "keywords": [
    "realtime",
    "websocket",
    "websockets",
    "channels",
    "pubsub",
    "fanout",
    "backpressure",
    "heartbeat",
    "e2ee",
    "encryption",
    "nodejs",
    "adapter",
    "oneunit"
  ],
  "author": "mayank",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oneunitjs/realtime.git"
  },
  "bugs": {
    "url": "https://github.com/oneunitjs/realtime/issues"
  },
  "homepage": "https://github.com/oneunitjs/realtime#readme",
  "dependencies": {
    "libsodium-wrappers": "^0.8.4",
    "notepack.io": "^3.0.1",
    "uwebsocket": "uNetworking/uWebSockets.js#v20.70.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.22.0",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "globals": "^17.14.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}